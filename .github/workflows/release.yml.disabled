name: Release binaries

on:
  push:
    tags:
      - 'v*.*.*'

permissions:
  contents: write

jobs:
  build:
    strategy:
      fail-fast: false
      matrix:
        target:
          - platform: darwin-arm64
            os: macos-latest
            bun-target: bun-darwin-arm64
            ext: ""
          - platform: darwin-x64
            os: macos-latest
            bun-target: bun-darwin-x64
            ext: ""
          - platform: linux-x64
            os: ubuntu-latest
            bun-target: bun-linux-x64
            ext: ""
          - platform: linux-arm64
            os: ubuntu-latest
            bun-target: bun-linux-arm64
            ext: ""
          - platform: windows-x64
            os: ubuntu-latest
            bun-target: bun-windows-x64
            ext: ".exe"

    runs-on: ${{ matrix.target.os }}
    steps:
      - uses: actions/checkout@v5

      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: latest

      - name: Install dev deps
        run: bun install --frozen-lockfile

      - name: Build ${{ matrix.target.platform }}
        run: |
          bun build ./src/index.ts \
            --compile \
            --target=${{ matrix.target.bun-target }} \
            --outfile "bin/fremi-${{ matrix.target.platform }}${{ matrix.target.ext }}"

      - name: Upload artifact
        uses: actions/upload-artifact@v5
        with:
          name: fremi-${{ matrix.target.platform }}
          path: bin/fremi-${{ matrix.target.platform }}${{ matrix.target.ext }}
          retention-days: 7

  release:
    needs: build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5

      - uses: actions/download-artifact@v5
        with:
          path: dist/

      - name: Flatten artifact dirs
        run: |
          mkdir -p release
          find dist -type f -exec cp {} release/ \;
          ls -la release/

      - name: Create GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ github.ref_name }}
          name: ${{ github.ref_name }}
          draft: false
          prerelease: false
          files: release/*
          generate_release_notes: true
