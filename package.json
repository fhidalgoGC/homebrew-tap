{
  "name": "fremi-framework",
  "version": "0.4.2",
  "description": "Product Discovery + SDD + BDD + TDD framework CLI for AI coding agents (Claude Code by now).",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/fhidalgoGC/homebrew-tap.git"
  },
  "author": "fhidalgoGC",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fremi": "./bin/fremi"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "clean:bun-cache": "bash scripts/clean-cache.sh",
    "build:darwin-arm64": "bash scripts/build.sh darwin-arm64",
    "build:darwin-x64": "bash scripts/build.sh darwin-x64",
    "build:linux-x64": "bash scripts/build.sh linux-x64",
    "build:linux-arm64": "bash scripts/build.sh linux-arm64",
    "build:windows-x64": "bash scripts/build.sh windows-x64",
    "build:all": "bash scripts/build-all.sh",
    "fremi:version": "bash scripts/fremi-run.sh version",
    "fremi:help": "bash scripts/fremi-run.sh help",
    "fremi:verify": "bash scripts/fremi-run.sh verify",
    "fremi:agent:install": "bash scripts/fremi-run.sh agent install",
    "fremi:agent:install:auto": "bash scripts/fremi-run.sh agent install --agent claude -y",
    "fremi:agent:uninstall": "bash scripts/fremi-run.sh agent uninstall",
    "fremi:agent:uninstall:auto": "bash scripts/fremi-run.sh agent uninstall --agent claude -y",
    "fremi:install": "bash scripts/fremi-install.sh",
    "fremi:install:init": "bash scripts/fremi-install.sh --init",
    "fremi:uninstall": "bash scripts/fremi-run.sh uninstall ./sandbox",
    "fremi:update": "bash scripts/fremi-run.sh update",
    "fremi:setting": "bash scripts/fremi-run.sh setting ./sandbox",
    "fremi:reset": "bash scripts/sandbox.sh reset",
    "sandbox:reset": "bash scripts/sandbox.sh reset",
    "sandbox:install": "bash scripts/sandbox.sh install",
    "sandbox:uninstall": "bash scripts/sandbox.sh uninstall",
    "sandbox:tree": "bash scripts/sandbox.sh tree",
    "sandbox:cycle": "bash scripts/sandbox.sh cycle",
    "release:publish": "bash scripts/release.sh publish",
    "release:sha256": "bash scripts/release.sh sha256"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
